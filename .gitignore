# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/

# Environments
.venv/
venv/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Application data. tickets.json lives under %APPDATA%, but WORKFLOWAPP_DATA_DIR
# can point it at the working tree, and a personal ticket list is not source.
tickets.json
tickets.json.corrupt-*
# A scratch data directory to point WORKFLOWAPP_DATA_DIR at. Named here rather
# than left to the rule above, which only covers it for as long as the only
# thing inside it happens to be called tickets.json.
.demo/

# Editors
.vscode/
.idea/
*.swp

# Windows
Thumbs.db
desktop.ini
