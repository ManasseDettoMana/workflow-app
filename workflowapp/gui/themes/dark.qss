/* Dark theme: dark grey with blue accents.
 *
 * Status tag colours are not here - a delegate paints those, and a stylesheet
 * cannot reach into one. See gui/theme.py, which carries a separate palette for
 * this theme because the light one is not readable on these backgrounds.
 */

QWidget {
    background-color: #1e222a;
    color: #e4e7eb;
    font-family: "Segoe UI", "Inter", sans-serif;
    font-size: 10pt;
}

QMainWindow, QDialog {
    background-color: #1e222a;
}

/* Toolbar ------------------------------------------------------------- */

QToolBar {
    background-color: #262b34;
    border: none;
    border-bottom: 1px solid #333a45;
    padding: 6px 8px;
    spacing: 6px;
}

QToolBar QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 6px 12px;
    color: #e4e7eb;
}

QToolBar QToolButton:hover {
    background-color: #323945;
    border-color: #3f4756;
}

QToolBar QToolButton:pressed {
    background-color: #3a4250;
}

QToolBar QToolButton:disabled {
    color: #6b7280;
}

QToolBar::separator {
    background-color: #333a45;
    width: 1px;
    margin: 4px 6px;
}

/* Table --------------------------------------------------------------- */
/* See the same section in light.qss for why every rule here is scoped to
 * #ticketTable: the calendar popup's day grid is a QTableView as well. */

QTableView#ticketTable {
    background-color: #262b34;
    alternate-background-color: #2b313b;
    border: 1px solid #333a45;
    border-radius: 6px;
    gridline-color: transparent;
    selection-background-color: #2f6fd0;
    selection-color: #ffffff;
    outline: none;
}

QTableView#ticketTable::item {
    padding: 6px 8px;
    border: none;
}

/* See the same rule in light.qss. Declaring QTableView::item hands item drawing
 * to the stylesheet, which then takes the selected cell's background from here
 * rather than from QTableView's selection-background-color. Left out, under Qt's
 * "windows11" style a selected row is painted exactly like an unselected one -
 * less destructive here than the white-on-white it causes in the light theme,
 * but still a selection that cannot be seen. */
QTableView#ticketTable::item:selected {
    background-color: #2f6fd0;
    color: #ffffff;
}

QTableView#ticketTable QHeaderView::section {
    background-color: #262b34;
    color: #9aa3b2;
    border: none;
    border-bottom: 1px solid #333a45;
    padding: 8px;
    font-weight: 600;
}

QTableView#ticketTable QHeaderView::section:hover {
    color: #e4e7eb;
}

/* Inputs -------------------------------------------------------------- */

QLineEdit, QPlainTextEdit, QTextEdit, QDateEdit, QComboBox, QSpinBox {
    background-color: #1a1e25;
    border: 1px solid #3f4756;
    border-radius: 4px;
    padding: 6px 8px;
    color: #e4e7eb;
    selection-background-color: #2f6fd0;
    selection-color: #ffffff;
}

QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus,
QDateEdit:focus, QComboBox:focus {
    border-color: #60a5fa;
}

QLineEdit:disabled, QDateEdit:disabled, QComboBox:disabled {
    background-color: #22272f;
    color: #6b7280;
}

QComboBox::drop-down, QDateEdit::drop-down {
    border: none;
    width: 22px;
}

QComboBox QAbstractItemView {
    background-color: #262b34;
    border: 1px solid #3f4756;
    selection-background-color: #2f6fd0;
    selection-color: #ffffff;
    padding: 4px;
}

/* Calendar popup ------------------------------------------------------- */
/* See the same section in light.qss. This theme is the reason it exists: the
 * unthemed popup was a white native calendar dropping out of a dark dialog. */

#qt_datetimedit_calendar {
    background-color: #262b34;
    border: 1px solid #3f4756;
    border-radius: 6px;
}

QCalendarWidget {
    background-color: #262b34;
}

QCalendarWidget QWidget#qt_calendar_navigationbar {
    background-color: #2b313b;
    border-bottom: 1px solid #333a45;
    min-height: 34px;
}

QCalendarWidget QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 4px 10px;
    color: #e4e7eb;
    font-weight: 600;
}

QCalendarWidget QToolButton:hover {
    background-color: #323945;
    border-color: #3f4756;
}

QCalendarWidget QToolButton:pressed {
    background-color: #3a4250;
}

QCalendarWidget QToolButton#qt_calendar_prevmonth,
QCalendarWidget QToolButton#qt_calendar_nextmonth {
    padding: 4px;
    min-width: 26px;
}

QCalendarWidget QSpinBox#qt_calendar_yearedit {
    background-color: #1a1e25;
    border: 1px solid #3f4756;
    border-radius: 4px;
    padding: 2px 6px;
    color: #e4e7eb;
}

/* No ::item rule here either - see light.qss. These four properties are what
 * QStyleSheetStyle folds into the palette QCalendarWidget::paintCell reads. */
QCalendarWidget QAbstractItemView#qt_calendar_calendarview {
    background-color: #262b34;
    color: #e4e7eb;
    selection-background-color: #2f6fd0;
    selection-color: #ffffff;
    border: none;
    outline: none;
}

QCalendarWidget QAbstractItemView#qt_calendar_calendarview:disabled {
    color: #7b8794;
}

/* Lists --------------------------------------------------------------- */

QListWidget {
    background-color: #1a1e25;
    border: 1px solid #3f4756;
    border-radius: 4px;
    outline: none;
    padding: 2px;
}

QListWidget::item {
    padding: 6px 4px;
    border-radius: 3px;
}

QListWidget::item:selected {
    background-color: #2f3f5c;
    color: #e4e7eb;
}

/* Buttons ------------------------------------------------------------- */

QPushButton {
    background-color: #323945;
    border: 1px solid #3f4756;
    border-radius: 4px;
    padding: 7px 16px;
    min-width: 80px;
    color: #e4e7eb;
}

QPushButton:hover {
    background-color: #3a4250;
    border-color: #4b5563;
}

QPushButton:pressed {
    background-color: #2b313b;
}

QPushButton:default {
    background-color: #2f6fd0;
    border-color: #2f6fd0;
    color: #ffffff;
    font-weight: 600;
}

QPushButton:default:hover {
    background-color: #3b7de0;
}

QPushButton:disabled {
    background-color: #262b34;
    color: #6b7280;
    border-color: #333a45;
}

/* The small square + and - buttons beside the activity list. */
QPushButton#activityButton {
    min-width: 30px;
    max-width: 30px;
    padding: 4px;
    font-weight: 600;
}

/* Misc ---------------------------------------------------------------- */

QLabel#sectionLabel {
    color: #9aa3b2;
    font-weight: 600;
}

QLabel#metaLabel {
    color: #7b8794;
    font-size: 9pt;
}

QLabel#emptyLabel {
    color: #7b8794;
    font-size: 11pt;
}

QStatusBar {
    background-color: #262b34;
    border-top: 1px solid #333a45;
    color: #9aa3b2;
}

QStatusBar::item {
    border: none;
}

QCheckBox {
    spacing: 8px;
}

/* See the same block in light.qss for why there is no tick glyph. The dark
 * theme is the reason this section exists at all: the native indicator is drawn
 * from the system palette and stays a light box on a dark dialog. */
QCheckBox::indicator, QListWidget::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #3f4756;
    border-radius: 3px;
    background-color: #1a1e25;
}

QCheckBox::indicator:hover, QListWidget::indicator:hover {
    border-color: #60a5fa;
}

QCheckBox::indicator:checked, QListWidget::indicator:checked {
    background-color: #2f6fd0;
    border-color: #2f6fd0;
}

QCheckBox::indicator:disabled, QListWidget::indicator:disabled {
    background-color: #22272f;
    border-color: #333a45;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #3f4756;
    border-radius: 5px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #4b5563;
}

QScrollBar::add-line, QScrollBar::sub-line {
    height: 0;
    width: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #3f4756;
    border-radius: 5px;
    min-width: 24px;
}

QToolTip {
    background-color: #0f1319;
    color: #e4e7eb;
    border: 1px solid #333a45;
    padding: 5px 8px;
}
