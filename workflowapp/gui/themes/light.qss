/* Light theme: blue on grey.
 *
 * Status tag colours are not here - a delegate paints those, and a stylesheet
 * cannot reach into one. See gui/theme.py.
 */

QWidget {
    background-color: #f4f6f8;
    color: #1f2933;
    font-family: "Segoe UI", "Inter", sans-serif;
    font-size: 10pt;
}

QMainWindow, QDialog {
    background-color: #f4f6f8;
}

/* Toolbar ------------------------------------------------------------- */

QToolBar {
    background-color: #ffffff;
    border: none;
    border-bottom: 1px solid #dfe3e8;
    padding: 6px 8px;
    spacing: 6px;
}

QToolBar QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 6px 12px;
    color: #1f2933;
}

QToolBar QToolButton:hover {
    background-color: #eef2f7;
    border-color: #d5dbe3;
}

QToolBar QToolButton:pressed {
    background-color: #e2e8f0;
}

QToolBar QToolButton:disabled {
    color: #a4adb8;
}

QToolBar::separator {
    background-color: #dfe3e8;
    width: 1px;
    margin: 4px 6px;
}

/* Table --------------------------------------------------------------- */
/* Scoped to #ticketTable throughout, and the header scoped as its descendant.
 * The calendar popup's day grid is a QTableView too, so an unscoped rule here
 * reaches inside it - including ::item, which would hand the day cell to
 * QStyleSheetStyle and paint over QCalendarWidget::paintCell. See the Calendar
 * section below, which relies on this one staying out of its way. */

QTableView#ticketTable {
    background-color: #ffffff;
    alternate-background-color: #fafbfc;
    border: 1px solid #dfe3e8;
    border-radius: 6px;
    gridline-color: transparent;
    selection-background-color: #2563eb;
    selection-color: #ffffff;
    outline: none;
}

QTableView#ticketTable::item {
    padding: 6px 8px;
    border: none;
}

/* Before the selection rules on purpose. A hovered selected row matches both
 * :hover and :selected at the same specificity, and Qt gives the later rule the
 * argument - the selection is the one that has to win.
 *
 * Declaring ::item took the native hover away with it, so without this there is
 * no pointer feedback at all. Qt hovers one cell where this table wants a whole
 * row; gui/widgets/table_view.py is what widens it. */
QTableView#ticketTable::item:hover {
    background-color: #e7eef8;
}

/* Not the same thing as the selection-* pair above, and not redundant with it.
 * Declaring QTableView::item at all hands item drawing to the stylesheet, and it
 * then takes the selected cell's background from this rule rather than from
 * QTableView's. Left out, under Qt's "windows11" style the cell keeps the view's
 * white background and still takes selection-color for its text: white on white,
 * and the ticket title vanishes the moment its row is selected. */
QTableView#ticketTable::item:selected {
    background-color: #2563eb;
    color: #ffffff;
}

/* A selection in a window that is no longer the active one. Quieter, so that
 * "which window am I typing into?" has an answer.
 *
 * The dark text is not decoration: #ffffff on this background is 1.2:1. The
 * status column is painted by a delegate that cannot see this rule, so
 * gui/widgets/status_badge.py reads State_Active and picks the palette's
 * selected_text_inactive - which has to keep agreeing with the colour here. */
QTableView#ticketTable::item:selected:!active {
    background-color: #ccdcf8;
    color: #1f2933;
}

QTableView#ticketTable QHeaderView::section {
    background-color: #ffffff;
    color: #52606d;
    border: none;
    border-bottom: 1px solid #dfe3e8;
    padding: 8px;
    font-weight: 600;
}

QTableView#ticketTable QHeaderView::section:hover {
    color: #1f2933;
}

/* Inputs -------------------------------------------------------------- */

QLineEdit, QPlainTextEdit, QTextEdit, QDateEdit, QComboBox, QSpinBox {
    background-color: #ffffff;
    border: 1px solid #cbd2d9;
    border-radius: 4px;
    padding: 6px 8px;
    selection-background-color: #2563eb;
    selection-color: #ffffff;
}

QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus,
QDateEdit:focus, QComboBox:focus {
    border-color: #2563eb;
}

QLineEdit:disabled, QDateEdit:disabled, QComboBox:disabled {
    background-color: #f0f2f5;
    color: #a4adb8;
}

QComboBox::drop-down, QDateEdit::drop-down {
    border: none;
    width: 22px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #cbd2d9;
    selection-background-color: #2563eb;
    selection-color: #ffffff;
    padding: 4px;
}

/* Calendar popup ------------------------------------------------------- */
/* The "Scadenza" QDateEdit's popup, which was entirely unthemed: a native white
 * calendar hanging off a dark dialog. Reached through Qt's own names for the
 * widget's internals - qt_calendar_* are what Qt's stylesheet documentation
 * uses, and they have not moved since Qt 4.
 *
 * The parts a stylesheet cannot reach are set in gui/ticket_dialog.py: Qt gives
 * the weekend a hard-coded red QTextCharFormat, and the month arrows a QIcon
 * baked from the style. Neither is reachable from here. */

#qt_datetimedit_calendar {
    background-color: #ffffff;
    border: 1px solid #cbd2d9;
    border-radius: 6px;
}

QCalendarWidget {
    background-color: #ffffff;
}

QCalendarWidget QWidget#qt_calendar_navigationbar {
    background-color: #ffffff;
    border-bottom: 1px solid #dfe3e8;
    min-height: 34px;
}

QCalendarWidget QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 4px 10px;
    color: #1f2933;
    font-weight: 600;
}

QCalendarWidget QToolButton:hover {
    background-color: #eef2f7;
    border-color: #d5dbe3;
}

QCalendarWidget QToolButton:pressed {
    background-color: #e2e8f0;
}

QCalendarWidget QToolButton#qt_calendar_prevmonth,
QCalendarWidget QToolButton#qt_calendar_nextmonth {
    padding: 4px;
    min-width: 26px;
}

QCalendarWidget QSpinBox#qt_calendar_yearedit {
    background-color: #ffffff;
    border: 1px solid #cbd2d9;
    border-radius: 4px;
    padding: 2px 6px;
    color: #1f2933;
}

/* The day grid. Deliberately no ::item rule anywhere in this section:
 * QCalendarWidget::paintCell draws the days itself, out of this view's palette,
 * and declaring ::item would hand the cell to QStyleSheetStyle and paint over
 * it. The four properties below are the ones QStyleSheetStyle folds into
 * QPalette Base, Text, Highlight and HighlightedText - which is exactly what
 * paintCell reads. Measured, not assumed. */
QCalendarWidget QAbstractItemView#qt_calendar_calendarview {
    background-color: #ffffff;
    color: #1f2933;
    selection-background-color: #2563eb;
    selection-color: #ffffff;
    border: none;
    outline: none;
}

/* Days belonging to the neighbouring month, which paintCell takes from the
 * palette's Disabled group. Below AA on purpose - they are meant to recede -
 * and the same colour the rest of this sheet already disables things in. */
QCalendarWidget QAbstractItemView#qt_calendar_calendarview:disabled {
    color: #a4adb8;
}

/* Lists --------------------------------------------------------------- */

QListWidget {
    background-color: #ffffff;
    border: 1px solid #cbd2d9;
    border-radius: 4px;
    outline: none;
    padding: 2px;
}

QListWidget::item {
    padding: 6px 4px;
    border-radius: 3px;
}

QListWidget::item:selected {
    background-color: #e0ebff;
    color: #1f2933;
}

/* Menus ---------------------------------------------------------------- */
/* The table's right-click menu. The calendar's month button drops a plain
 * QMenu of its own, so this one section serves both. */

QMenu {
    background-color: #ffffff;
    border: 1px solid #cbd2d9;
    border-radius: 6px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 24px 6px 12px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #2563eb;
    color: #ffffff;
}

QMenu::item:disabled {
    color: #a4adb8;
}

QMenu::separator {
    height: 1px;
    background-color: #dfe3e8;
    margin: 4px 8px;
}

/* Buttons ------------------------------------------------------------- */

QPushButton {
    background-color: #ffffff;
    border: 1px solid #cbd2d9;
    border-radius: 4px;
    padding: 7px 16px;
    min-width: 80px;
}

QPushButton:hover {
    background-color: #f0f4f9;
    border-color: #a9b4c0;
}

QPushButton:pressed {
    background-color: #e2e8f0;
}

QPushButton:default {
    background-color: #2563eb;
    border-color: #2563eb;
    color: #ffffff;
    font-weight: 600;
}

QPushButton:default:hover {
    background-color: #1d4fd7;
}

QPushButton:disabled {
    background-color: #f0f2f5;
    color: #a4adb8;
    border-color: #dfe3e8;
}

/* The small square + and - buttons beside the activity list. */
QPushButton#activityButton {
    min-width: 30px;
    max-width: 30px;
    padding: 4px;
    font-weight: 600;
}

/* Misc ---------------------------------------------------------------- */

QLabel#sectionLabel {
    color: #52606d;
    font-weight: 600;
}

QLabel#metaLabel {
    color: #7b8794;
    font-size: 9pt;
}

QLabel#emptyLabel {
    color: #7b8794;
    font-size: 11pt;
}

QStatusBar {
    background-color: #ffffff;
    border-top: 1px solid #dfe3e8;
    color: #52606d;
}

QStatusBar::item {
    border: none;
}

/* The transparent background is load-bearing, not tidiness: these two sit on
 * the status bar rather than on the window, and without it the global QWidget
 * rule paints the window's #f4f6f8 as two grey patches on the white bar. The
 * labels above get away without it because they sit on the window itself. */
QLabel#statusLabel {
    background-color: transparent;
    color: #52606d;
    padding: 0 4px;
}

QLabel#overdueLabel {
    background-color: transparent;
    color: #b91c1c;
    font-weight: 600;
    padding: 0 4px;
}

QCheckBox {
    spacing: 8px;
}

/* There is no tick glyph inside the checked box. A stylesheet cannot draw one
 * without an image: url(), and a new runtime resource has to be declared in
 * [tool.setuptools.package-data] and in the spec's datas or it loads from a
 * source checkout and is missing from the frozen build. A filled accent square
 * against an empty outlined one is unambiguous enough not to be worth three
 * places to remember it. What this replaces is the native indicator, drawn from
 * the system palette and staying light in the dark theme - the same class of
 * defect as a selected row that cannot be read. */
QCheckBox::indicator, QListWidget::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #cbd2d9;
    border-radius: 3px;
    background-color: #ffffff;
}

QCheckBox::indicator:hover, QListWidget::indicator:hover {
    border-color: #2563eb;
}

QCheckBox::indicator:checked, QListWidget::indicator:checked {
    background-color: #2563eb;
    border-color: #2563eb;
}

QCheckBox::indicator:disabled, QListWidget::indicator:disabled {
    background-color: #f0f2f5;
    border-color: #dfe3e8;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #cbd2d9;
    border-radius: 5px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #a9b4c0;
}

QScrollBar::add-line, QScrollBar::sub-line {
    height: 0;
    width: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #cbd2d9;
    border-radius: 5px;
    min-width: 24px;
}

QToolTip {
    background-color: #1f2933;
    color: #ffffff;
    border: none;
    padding: 5px 8px;
}
